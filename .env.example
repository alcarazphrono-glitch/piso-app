# Copia este archivo a .env.local y llena los valores reales.
# Ninguno de estos vive en el código -- ver README.md, sección
# "Lo que necesitas crear antes de que esto corra de verdad".

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# --- Mesa de derivados (/admin/mesa) -- solo servidor, nunca NEXT_PUBLIC ---
# Service role de Supabase: los agentes analistas escriben propuestas con ella.
SUPABASE_SERVICE_ROLE_KEY=
# Banxico SIE (gratis): https://www.banxico.org.mx/SieAPIRest/service/v1/token
BANXICO_TOKEN=
# INEGI BIE (gratis): https://www.inegi.org.mx/app/api/indicadores/interna_v1_1/tokenVerify.aspx
INEGI_TOKEN=
# Claude redacta la lectura de cada hallazgo. Sin esta llave se usa una plantilla.
ANTHROPIC_API_KEY=
# Vercel Cron manda este secreto al correr a los analistas (L-V 7:00 CDMX).
CRON_SECRET=
